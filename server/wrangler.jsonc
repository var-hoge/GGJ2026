{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "phantomcat-game-server",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// --- Matching API (Hono) storage ---
	"d1_databases": [
		{
			"binding": "phantomcat_game_db",
			"database_name": "phantomcat-game-db",
			"database_id": "fdc153c8-7ee3-4f22-96c6-7fc339e4a966"
		}
	],
	// --- Signaling (PartyKit-style rooms via partyserver, running as Durable Objects
	//     inside THIS SAME worker - no separate deployment) ---
	"durable_objects": {
		"bindings": [
			{
				"name": "Lobby",
				"class_name": "Lobby"
			},
			{
				"name": "Room",
				"class_name": "Room"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Lobby",
				"Room"
			]
		}
	]
}